# MongoDB connection string
# Local:  mongodb://localhost:27017/propertybazaar
# Atlas:  mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/propertybazaar
MONGO_URI=your_mongodb_connection_string_here

# Server port
PORT=5000

# JWT secret (for later, when we add authentication routes)
JWT_SECRET=your_jwt_secret_here

# Google OAuth (for later, when we add "Continue with Google")
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Cloudinary (for image/video uploads)
# Get these from cloudinary.com dashboard after signup
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
